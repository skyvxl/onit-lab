FROM golang:1.27-bookworm AS source
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
FROM source AS test
RUN go test ./...

FROM source AS build
ARG APP_VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X onit_laba1/internal/web.buildVersion=${APP_VERSION}" \
    -o /app/main ./cmd/server

FROM alpine:3.24 AS prod
WORKDIR /app
RUN apk --no-cache add ca-certificates
COPY --from=build /app/main .
COPY --from=build /app/web/templates ./web/templates
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/main"]
